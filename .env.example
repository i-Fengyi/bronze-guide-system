DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-flash-2025-07-28

# Optional local paths. Defaults use Hugging Face model IDs and cache automatically.
VESSEL_CLASSIFIER_PATH=models/vessel_classifier/best.pt
VISION_WEIGHTS_PATH=models/resnet-18
TEXT_EMBEDDING_MODEL_PATH=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DATA_DIR=data
IMAGE_DIR=data/exhibit_gallery
GALLERY_SPLIT_PATH=data/exhibit_gallery_split.json
VESSEL_TYPE_THRESHOLD=0.65
EXHIBIT_SIMILARITY_THRESHOLD=0.82
MATCH_MARGIN_THRESHOLD=0.07
EXHIBIT_CANDIDATE_FLOOR=0.68
